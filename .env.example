# Names only. Real values go in .env.local (git-ignored), GitHub Secrets and Cloud Run.
# `neon init` / `neon env pull --file .env.local` writes the Neon ones.

# API
PORT=
# Pooled Neon connection, used by the running API.
DATABASE_URL=
# Direct Neon connection, used by `pnpm db:migrate` (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=
# Web: where the Next.js server reaches the API (server-side only).
API_URL=
